  assert(JSON.stringify(beforeReset.dfe_tap_tuners)===JSON.stringify(afterReset.dfe_tap_tuners),'Reset changed DFE');
  assert(await page.locator('#selected-run').inputValue()===run.task_id,'Reset cleared selected Run');
